    "### GSEA {#Func_en_GSEA}\n",
    "\n",
    "```{freyre_script GSEA_analysis}\n",
    "\n",
    "GSEA_analysis <- function(\n",
    "  filtered_df,\n",
    "  name_mth,\n",
    "  ont_t,\n",
    "  num_f,\n",
    "  name_f = \"GSEA.png\"\n",
